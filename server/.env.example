# Server Configuration
NODE_ENV=production
PORT=5000

# MongoDB Configuration
# For local development:
# MONGO_URI=mongodb://127.0.0.1:27017/travel_erp
# For production (MongoDB Atlas):
MONGO_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/travel_erp?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=change_this_to_a_long_random_secret_in_production
JWT_EXPIRES_IN=7d

# CORS Configuration - Allow multiple origins (comma-separated)
# For local development from localhost:
CLIENT_URL=http://localhost:5173

# For production with multiple origins:
# CLIENT_URL=http://localhost:5173,https://yourdomain.com,https://apitravel360.salexo.co.in

# To allow all origins (not recommended for production):
# CLIENT_URL=*
