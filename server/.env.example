# Server Configuration
NODE_ENV=production
PORT=5000

# MongoDB Configuration
# For local development:
# MONGO_URI=mongodb://127.0.0.1:27017/travel_erp
# For production (MongoDB Atlas):
MONGO_URI=mongodb+srv://travel360:Travel36012345@cluster0.ojnzynw.mongodb.net/travel_erp?appName=Cluster0

# JWT Configuration
JWT_SECRET=change_this_to_a_long_random_secret_in_production
