# CORS Configuration - Allow multiple origins (comma-separated)
# For local development from localhost:
CLIENT_URL=https://travel-erp-api.vercel.app

# For production with multiple origins:
# CLIENT_URL=http://localhost:5173,https://yourdomain.com,https://apitravel360.salexo.co.in

# To allow all origins (not recommended for production):
# CLIENT_URL=*
